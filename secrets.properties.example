# Copy to `secrets.properties` (gitignored) and fill in to bake values into your
# local build. Absent/blank values simply leave the app blank, configurable in
# the Settings screen. Nothing here is committed except this example.
HMAC_ACCESS_KEY=
HMAC_SECRET_KEY=
PASSWORD_PUBLIC_KEY=
PROD_SECRET=
# Overseas-app (Azure gateway) message-inbox credentials.
# AK/SK for the X-HMAC-* signature (libenv.so getNativeApplicationId/getNativeSecret, EU/PROD):
OVERSEAS_ACCESS_KEY=
OVERSEAS_SECRET_KEY=
# HS256 secret that signs the client-minted `Authorization` token (InboxAuthToken).
# String-obfuscated in the stock APK — Frida-dump it at runtime (see reversing notes):
INBOX_AUTH_SECRET=
VIN_KEY=
VIN_IV=
USER_ID=
EMAIL=
PASSWORD=
VIN=
